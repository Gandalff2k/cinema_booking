# Copy this file to `.env` and fill in real values before running the stack.

# Database

DATABASE_URL=postgresql+asyncpg://postgres:password123@postgresql:5432/fastapi-db
POSTGRES_PASSWORD=password123

# Environment

ENVIRONMENT=development
# 1 in development (verbose logs, request bodies logged, /docs enabled).
# 0 in production.
DEBUG=1
SHOW_SQL_ALCHEMY_QUERIES=0

# Logging
# 
LOG_TO_FILE=True
LOG_DIR=logs
LOG_MAX_MB=20
LOG_BACKUP_COUNT=3
# Only takes effect when DEBUG=1. Turn off in production even if DEBUG were
# ever left on, since request bodies can contain personal data.
LOG_REQUEST_BODY=True

# Redis 
REDIS_URL=redis://redis:6379/0

# MinIO object storage (poster images)
# Change these before any non-local deployment. See README -> "Object storage
# in production" for how these stay safe while still being easy to manage.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-value
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=movies
MINIO_SECURE=False

# Security
SECRET_KEY=change-me-generate-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Admin bootstrap 
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Rate limiting (Redis fixed-window)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_TIMES=20
RATE_LIMIT_WINDOW_SECONDS=60


# Stripe
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen` (local) or the webhook's signing secret (production)
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Used to build the Stripe checkout success/cancel redirect URLs
FRONTEND_URL=http://localhost
# Comma-separated allowed origins for CORS, or "*" for all. Restrict this to
# your real domain(s) in production, e.g. https://cinemax.example.com
CORS_ORIGINS=*


# Email / SMTP (ticket delivery)
EMAILS_ENABLED=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_FROM=CinemaX <no-reply@example.com>
